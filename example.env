# ShopSense AI — Environment Configuration Template
# Copy this file to .env and configure your environment variables.

FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-insecure-secret-key-shopsense-ai-2026

# Database URI (SQLite by default)
DATABASE_URL=sqlite:///instance/shopsense.db

# Platform Settings
PROJECT_NAME=ShopSense AI
CURRENCY_SYMBOL=₹
DEFAULT_PAGINATION_LIMIT=20
