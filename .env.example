# Flask Configuration
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace_with_a_secure_random_secret_key_in_production

# Database Configuration (SQLite default, PostgreSQL ready)
DATABASE_URL=sqlite:///shopsense.db
# DATABASE_URL=postgresql://user:password@localhost:5432/shopsense_db

# AI Provider Configuration (mock/local fallback active by default)
AI_PROVIDER=local
AI_API_KEY=your_ai_api_key_here
AI_MODEL=local-hybrid-v1
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024

# Session & Security
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
PERMANENT_SESSION_LIFETIME=86400

# Application Settings
APP_NAME=ShopSense AI
CURRENCY_SYMBOL=₹
PAGINATION_PER_PAGE=12
LOG_LEVEL=INFO
